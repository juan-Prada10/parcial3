<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="212.0" prefWidth="352.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderia.viewController.CancelarPedidoViewController">
   <children>
      <Text fill="#c68325" fontSmoothingType="LCD" layoutX="79.0" layoutY="55.0" strokeType="OUTSIDE" strokeWidth="0.0" text="CancelarPedido">
         <font>
            <Font size="29.0" />
         </font>
      </Text>
      <TextField fx:id="txtCodigo" layoutX="41.0" layoutY="106.0" prefHeight="31.0" prefWidth="276.0" promptText="Ingrese el codigo del pedido a eliminar">
         <effect>
            <Lighting diffuseConstant="2.0">
               <bumpInput>
                  <ColorAdjust />
               </bumpInput>
               <light>
                  <Light.Distant color="#c99a42" />
               </light>
            </Lighting>
         </effect></TextField>
      <Button fx:id="btnCancelarPedido" layoutX="140.0" layoutY="153.0" mnemonicParsing="false" onAction="#cancelarPedidoEvent" text="Cancelar">
         <effect>
            <Lighting>
               <bumpInput>
                  <ColorAdjust />
               </bumpInput>
               <light>
                  <Light.Distant color="#e0a96d" />
               </light>
            </Lighting>
         </effect></Button>
      <Separator layoutX="79.0" layoutY="65.0" prefWidth="200.0" />
      <Text layoutX="84.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ingrese el codigo del pedido" />
   </children>
   <effect>
      <Lighting diffuseConstant="2.0">
         <bumpInput>
            <ColorAdjust />
         </bumpInput>
         <light>
            <Light.Distant />
         </light>
      </Lighting>
   </effect>
</AnchorPane>
